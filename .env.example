# ===================================
# ZO CHATBOT - Environment Variables
# ===================================
# Copia este archivo a .env.local y completa con tus valores
# Ver docs/environment-variables.md para más detalles

# ===================================
# SUPABASE (OBLIGATORIO)
# ===================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
DATABASE_URL=postgresql://postgres:password@db.xxx.supabase.co:5432/postgres?pgbouncer=true

# ===================================
# AI / ML (Opcional pero Recomendado)
# ===================================

# Groq (Primary AI - Ultra Fast)
GROQ_API_KEY=gsk_...

# Cloudflare AI (Fallback)
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

# ===================================
# WHATSAPP (Opcional)
# ===================================
# EVOLUTION_API_URL=https://your-evolution-api.com
# EVOLUTION_API_KEY=your-api-key

# ===================================
# FACEBOOK/INSTAGRAM (Opcional)
# ===================================
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# FACEBOOK_VERIFY_TOKEN=mi-token-secreto-123
# FACEBOOK_PAGE_ACCESS_TOKEN=

# ===================================
# TIKTOK (Opcional)
# ===================================
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=

# ===================================
# CONFIGURACIÓN
# ===================================
NODE_ENV=development
LOG_LEVEL=debug
QUEUE_BATCH_SIZE=10
QUEUE_CONCURRENCY=5

# Application URL (usado para webhooks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===================================
# MONITORING (Opcional)
# ===================================
# SENTRY_DSN=
